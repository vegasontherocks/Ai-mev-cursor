# Polygon MEV Bot - example env file (DO NOT commit real secrets)

# Wallet & RPC
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
ETH_RPC_URL=https://polygon-rpc.com
ETH_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/your_ws_key

# Thirdweb / MCP (Nebula) - if using Thirdweb hosted MCP
THIRDWEB_CLIENT_ID=your_thirdweb_client_id
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key
MCP_SERVER_URL=http://localhost:8080

# Agent & execution toggles
DRY_RUN=true  # set to false to allow live submissions (use with caution)
ALLOW_EXECUTION=false

# LLM / Nebula / Monitoring
OPENAI_API_KEY=sk-xxxx
NEBULA_MODEL=nebula-model-name-or-id

# Optional services
TENDERLY_PROJECT_SLUG=your_tenderly_project
SENTRY_DSN=

# Logging / diagnostics
LOG_LEVEL=info

# Safety & sizing
MAX_GAS_PRICE_GWEI=120
MAX_SLIPPAGE_BPS=50

# Notes:
# - Copy this file to `.env` and fill in real values locally.
# - Keep .env out of source control. Use a secrets manager in production.
# Blockchain Configuration
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_KEY

# Wallet
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS

# API Keys
THIRDWEB_CLIENT_ID=YOUR_THIRDWEB_CLIENT_ID
THIRDWEB_SECRET_KEY=YOUR_THIRDWEB_SECRET_KEY
# Optional override. Defaults to https://api.thirdweb.com/mcp when unset.
THIRDWEB_MCP_URL=
# Optional test wallet for smoke tests (0x...)
THIRDWEB_MCP_TEST_WALLET=
# Enable to route executions through Thirdweb MCP server wallet
THIRDWEB_USE_MCP_EXECUTION=false
THIRDWEB_CHAIN_ID=137
THIRDWEB_SERVER_WALLET_IDENTIFIER=
THIRDWEB_SERVER_WALLET_ADDRESS=
THIRDWEB_USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
THIRDWEB_DEMO_RECIPIENT=
THIRDWEB_DEMO_AMOUNT=1000000
THIRDWEB_DEMO_SEND=false
BLOCKNATIVE_API_KEY=YOUR_BLOCKNATIVE_KEY
BLOXROUTE_AUTH_HEADER=YOUR_BLOXROUTE_AUTH

# Contract Addresses (will be set after deployment)
MEV_EXECUTOR_ADDRESS=
BALANCER_VAULT_ADDRESS=0xBA12222222228d8Ba445958a75a0704d566BF2C8
MEV_MIN_PROFIT=10000000000000000 # 0.01 MATIC
MEV_MAX_LOSS=100000000000000000 # 0.1 MATIC
MEV_DAILY_LIMIT=5000000000000000000 # 5 MATIC

# Eliza Agent Configuration
ELIZA_MODEL_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=YOUR_OPENAI_KEY

# Risk Management
MIN_PROFIT_THRESHOLD=0.01
MAX_GAS_PRICE=500
SLIPPAGE_TOLERANCE=0.005

# FastLane
FASTLANE_ENABLED=true
FASTLANE_RELAY_URL=https://polygon-relay.flashbots.net

# Monitoring
GRAFANA_API_KEY=
DISCORD_WEBHOOK_URL=

# Simulation and execution guards
# Use DRY_RUN=true to prevent any on-chain sends from the agent
DRY_RUN=true
# Require explicit opt-in to allow real sends
ALLOW_EXECUTION=false
ALLOW_NEBULA_EXECUTION=false

# Optional simulation configuration
SIMULATION_RPC_URL=
TENDERLY_USER=
TENDERLY_PROJECT=
TENDERLY_ACCESS_KEY=
