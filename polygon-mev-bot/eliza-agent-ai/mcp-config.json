{
  "mcpServers": {
    "polygon": {
      "command": "npx",
      "args": [
        "-y",
        "tsx",
        "../mcp-servers/polygon-blockchain/src/index.ts"
      ],
      "env": {
        "POLYGON_RPC_URL": "${POLYGON_RPC_URL}",
        "POLYGON_WSS_URL": "${POLYGON_WSS_URL}"
      }
    },
    "thirdweb": {
      "url": "https://api.thirdweb.com/mcp?secretKey=${THIRDWEB_SECRET_KEY}",
      "description": "Hosted Thirdweb MCP tools (listServerWallets, createServerWallet, readContract, etc.)"
    }
  }
}