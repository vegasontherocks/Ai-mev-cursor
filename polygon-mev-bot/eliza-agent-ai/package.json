{
  "name": "@mev-bot/eliza-agent-ai",
  "version": "2.0.0",
  "description": "AI-powered MEV bot using Thirdweb Nebula blockchain LLM",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node --loader ts-node/esm src/index.ts",
    "dev": "nodemon --exec node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "mcp": "npx -y @thirdweb-dev/mcp-server",
    "smoke:encode": "ts-node --esm src/utils/smokeEncode.ts",
    "preflight:sim": "ts-node --esm src/utils/preflightSim.ts",
    "build:prod": "tsc -p tsconfig.json",
    "start:prod:direct": "node dist/index.js",
    "start:prod": "node scripts/autoStartAndRunDiag.mjs",
    "debug:quotes": "ts-node --esm src/scripts/debugQuotes.ts",
    "compare:adapters": "node scripts/compareAdapters.mjs",
    "telemetry:show": "node scripts/showQuoteTelemetry.mjs",
    "smoke:mcp": "node --loader ts-node/esm src/scripts/smokeMcp.ts",
    "thirdweb:wallet": "node --loader ts-node/esm src/scripts/thirdwebServerWalletDemo.ts",
    "canary:run": "node dist/utils/canaryRun.js",
    "setup:model": "node --loader ts-node/esm scripts/downloadRLModel.ts",
    "verify:setup": "node --loader ts-node/esm scripts/verifySetup.ts",
    "postinstall:manual": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@ai16z/eliza": "^0.1.4",
    "@ai16z/adapter-sqlite": "^0.1.0",
    "@thirdweb-dev/sdk": "^4.0.0",
    "@ai-sdk/openai": "^0.0.24",
    "ai": "^3.0.0",
    "ethers": "^5.7.2",
    "dotenv": "^16.3.1",
    "ws": "^8.14.2",
    "uuid": "^9.0.1",
    "onnxruntime-node": "^1.17.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.9",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2"
  }
}